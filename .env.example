# Never commit real credentials. Configure these in your hosting provider's secret settings.
NODE_ENV=production
PORT=10000
APP_URL=https://coinixfaucet.mine.bz

# FaucetPay scoped API key with the SEND scope.
# Create it in FaucetPay -> Faucet owner dashboard -> Manage -> Scoped API keys.
FAUCETPAY_API_KEY=

# Existing application secrets (keep your current production values).
BOT_TOKEN=
BOT_USERNAME=CoinixBot
JWT_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=
ADMIN_TELEGRAM_ID=
ADMIN_SECRET_KEY=
# Offerwall.me placement credentials. Never expose private keys in frontend code.
OFFERWALL_APP_ID=
OFFERWALL_SECRET_KEY=
OFFERWALL_API_TOKEN=

# Firebase Authentication (Google provider enabled in Firebase Console).
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
