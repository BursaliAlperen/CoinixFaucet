# Railway service variables — never commit real credentials
NODE_ENV=production
PORT=3000
BOT_TOKEN=
BOT_USERNAME=CoinixFaucet_bot
ADMIN_IDS=
ANNOUNCEMENT_CHANNEL_ID=
BOT_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://YOUR-COINIX-SERVICE.up.railway.app
WEBAPP_URL=https://YOUR-COINIX-SERVICE.up.railway.app
APP_ORIGIN=https://YOUR-COINIX-SERVICE.up.railway.app

# Required channel membership gate
REQUIRED_CHANNEL_ID=@your_channel_or_-100_id
REQUIRED_CHANNEL_URL=https://t.me/your_channel

# Firebase Admin service account JSON (secret)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_DATABASE_URL=

# Firebase Web App config (public values from the SAME Firebase project)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MEASUREMENT_ID=

# Publisher / ad providers — keys are server-only
PIARFLOW_API_KEY=
FLYERHUBS_KEY=
TRAFFY_API_KEY=
# Traffy tracking link prefix from your own publisher link, without "l_" and trailing label
TRAFFY_LINK_PREFIX=

REWARD_TIMEZONE=Europe/Istanbul
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
